# ─────────────────────────────────────────────
# SalonFlow — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/salonflow"

# ── Redis ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Clerk Auth ────────────────────────────────
# Get from https://dashboard.clerk.com
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/onboarding"

# ── WhatsApp (Meta Cloud API) ─────────────────
# Get from https://developers.facebook.com
META_WHATSAPP_PHONE_NUMBER_ID="1234567890"
META_WHATSAPP_ACCESS_TOKEN="EAAxxxxx..."
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN="your-random-verify-token"

# ── App URLs ──────────────────────────────────
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Stripe (Phase 7) ──────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Misc ──────────────────────────────────────
NODE_ENV="development"
PORT="3001"
